# Copy to .env.local for local development:
#   cp .env.example .env.local
#
# On Netlify: Site settings → Environment variables (same keys, no .env.local file)

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Admin login (client-side; use strong values in production)
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_ADMIN_PASSWORD=change-me

# Must match Supabase Edge Function secret ADMIN_SECRET (for create-user)
NEXT_PUBLIC_ADMIN_FUNCTION_SECRET=change-me

# Optional: LAN dev IP for HMR when opening http://192.168.x.x:3000
ALLOWED_DEV_ORIGINS=192.168.1.3
