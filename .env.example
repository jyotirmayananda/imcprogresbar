# Copy to .env.local for local dev:  cp .env.example .env.local
# Netlify: Site settings → Environment variables (all scopes: Build + Runtime)

# --- Supabase (Dashboard → Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://kkufsetqslfxqemtbdch.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# --- Production site (for your reference; also add in Supabase Auth → URL config) ---
# https://imcprogresbar.netlify.app
# Supabase Auth → Redirect URLs: https://imcprogresbar.netlify.app/**

# --- Admin login (Netlify env — must match what you use on /login) ---
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com
NEXT_PUBLIC_ADMIN_PASSWORD=your-strong-admin-password

# MUST equal Supabase Edge Function secret ADMIN_SECRET (create-user function)
NEXT_PUBLIC_ADMIN_FUNCTION_SECRET=your-strong-admin-password

# --- Local only: LAN HMR when using http://192.168.x.x:3000 ---
ALLOWED_DEV_ORIGINS=192.168.1.3
